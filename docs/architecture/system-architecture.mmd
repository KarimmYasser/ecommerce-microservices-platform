%% E-commerce microservices — full system architecture
%% Optimized for Excalidraw import (Menu -> Insert -> Mermaid to Excalidraw)
%% Source of truth: docs/architecture/01-system-overview.md, 02-service-topology.md, 03-request-flows.md
flowchart TB

    subgraph CLIENT_LAYER ["External Client Layer"]
        Client["Client / Postman<br/>(Browser, Mobile App, API Client)"]
    end

    subgraph GW_LAYER ["API Gateway Layer (:8080)"]
        Gateway["api-gateway<br/>Spring Cloud Gateway<br/>Routing / Load Balancing / JWT Auth Gate"]
    end

    subgraph INFRA_LAYER ["Cloud Infrastructure Services"]
        Config["config-server (:8888)<br/>Centralised Configuration"]
        Eureka["eureka-server (:8761)<br/>Service Discovery"]
        Config ~~~ Eureka
    end

    subgraph BIZ_LAYER ["Core Business Microservices"]
        Inventory["inventory-service (:8081)<br/>Products / Categories / Variants / Stock"]
        Wallet["wallet-service (:8082)<br/>Users / Auth (JWT Issuer) / Wallet / Ledger"]
        Shop["shop-service (:8083)<br/>Cart / Wishlist / Orders / Reviews<br/>(Checkout Saga Orchestrator)"]
        Inventory ~~~ Wallet ~~~ Shop
    end

    subgraph DATA_LAYER ["MySQL Database Layer (Schema per Service)"]
        InvDB[("inventory_db<br/>(MySQL)")]
        WalDB[("wallet_db<br/>(MySQL)")]
        ShopDB[("shop_db<br/>(MySQL)")]
        InvDB ~~~ WalDB ~~~ ShopDB
    end

    %% Flow Connections
    Client -->|"HTTPS / REST"| Gateway

    Gateway -->|"lb://inventory-service"| Inventory
    Gateway -->|"lb://wallet-service"| Wallet
    Gateway -->|"lb://shop-service"| Shop

    %% Inter-Service Feign Calls
    Shop -->|"Feign: Reserve/Release Stock"| Inventory
    Shop -->|"Feign: Debit/Credit Balance"| Wallet

    %% Database Bindings
    Inventory --- InvDB
    Wallet --- WalDB
    Shop --- ShopDB

    %% Infrastructure Registration & Config
    Gateway -.->|"Discover"| Eureka
    Inventory -.->|"Register & Discover"| Eureka
    Wallet -.->|"Register & Discover"| Eureka
    Shop -.->|"Register & Discover"| Eureka

    Gateway -.->|"Fetch Config"| Config
    Inventory -.->|"Fetch Config"| Config
    Wallet -.->|"Fetch Config"| Config
    Shop -.->|"Fetch Config"| Config
    Eureka -.->|"Fetch Config"| Config

    %% Custom Styling & Color Scheme
    classDef clientStyle fill:#4f46e5,stroke:#3730a3,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef gatewayStyle fill:#0284c7,stroke:#0369a1,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef bizStyle fill:#0f766e,stroke:#115e59,stroke-width:2px,color:#ffffff;
    classDef shopStyle fill:#b45309,stroke:#78350f,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef infraStyle fill:#7e22ce,stroke:#581c87,stroke-width:2px,color:#ffffff;
    classDef dbStyle fill:#c2410c,stroke:#9a3412,stroke-width:2px,color:#ffffff,font-weight:bold;

    class Client clientStyle;
    class Gateway gatewayStyle;
    class Inventory,Wallet bizStyle;
    class Shop shopStyle;
    class Config,Eureka infraStyle;
    class InvDB,WalDB,ShopDB dbStyle;


