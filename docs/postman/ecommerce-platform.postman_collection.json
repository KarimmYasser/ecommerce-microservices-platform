{
	"info": {
		"name": "Ejada E-Commerce Platform",
		"description": "Comprehensive Postman collection for Ejada E-Commerce Platform. Base URL points to API Gateway (http://localhost:8080). Login automatically extracts JWT token and stores it in the collection variable 'jwt'.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" },
		{ "key": "jwt", "value": "" }
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": "{{baseUrl}}/api/v1/auth/register",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"Customer123!\",\n  \"fullName\": \"John Customer\"\n}"
						}
					}
				},
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set(\"jwt\", jsonData.token);",
									"    console.log(\"Captured JWT token: \" + jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": "{{baseUrl}}/api/v1/auth/login",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"Customer123!\"\n}"
						}
					}
				}
			]
		},
		{
			"name": "Wallet",
			"item": [
				{
					"name": "Get My Wallet",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt}}" }
						],
						"url": "{{baseUrl}}/api/v1/wallets/me"
					}
				},
				{
					"name": "Deposit",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": "{{baseUrl}}/api/v1/wallets/me/deposit",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 500.00\n}"
						}
					}
				}
			]
		},
		{
			"name": "Catalog",
			"item": [
				{
					"name": "List Products",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/v1/products?page=0&size=10"
					}
				},
				{
					"name": "Get Product Details",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/v1/products/1"
					}
				},
				{
					"name": "List Categories",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/v1/categories"
					}
				}
			]
		},
		{
			"name": "Cart",
			"item": [
				{
					"name": "Get My Cart",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt}}" }
						],
						"url": "{{baseUrl}}/api/v1/cart"
					}
				},
				{
					"name": "Add Item to Cart",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": "{{baseUrl}}/api/v1/cart/items",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": 1,\n  \"variantId\": 1,\n  \"quantity\": 2\n}"
						}
					}
				},
				{
					"name": "Update Cart Item Quantity",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": "{{baseUrl}}/api/v1/cart/items/1",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"quantity\": 3\n}"
						}
					}
				},
				{
					"name": "Remove Item from Cart",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt}}" }
						],
						"url": "{{baseUrl}}/api/v1/cart/items/1"
					}
				},
				{
					"name": "Clear Cart",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt}}" }
						],
						"url": "{{baseUrl}}/api/v1/cart"
					}
				}
			]
		},
		{
			"name": "Wishlist",
			"item": [
				{
					"name": "Get My Wishlist",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt}}" }
						],
						"url": "{{baseUrl}}/api/v1/wishlist"
					}
				},
				{
					"name": "Add Product to Wishlist",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": "{{baseUrl}}/api/v1/wishlist/items",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": 1\n}"
						}
					}
				},
				{
					"name": "Remove Product from Wishlist",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt}}" }
						],
						"url": "{{baseUrl}}/api/v1/wishlist/items/1"
					}
				}
			]
		},
		{
			"name": "Orders & Checkout Saga",
			"item": [
				{
					"name": "Checkout (Create Order)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": "{{baseUrl}}/api/v1/orders",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"shippingAddress\": \"123 Tech Avenue, Innovation City\"\n}"
						}
					}
				},
				{
					"name": "Get My Orders",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt}}" }
						],
						"url": "{{baseUrl}}/api/v1/orders?page=0&size=10"
					}
				},
				{
					"name": "Get Order Details",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt}}" }
						],
						"url": "{{baseUrl}}/api/v1/orders/1"
					}
				},
				{
					"name": "Cancel Order",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt}}" }
						],
						"url": "{{baseUrl}}/api/v1/orders/1/cancel"
					}
				}
			]
		},
		{
			"name": "Reviews",
			"item": [
				{
					"name": "Get Product Reviews",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/v1/products/1/reviews?page=0&size=10"
					}
				},
				{
					"name": "Add Product Review",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": "{{baseUrl}}/api/v1/products/1/reviews",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"rating\": 5,\n  \"title\": \"Excellent Quality\",\n  \"body\": \"Super fast delivery and great build quality.\"\n}"
						}
					}
				}
			]
		}
	]
}
