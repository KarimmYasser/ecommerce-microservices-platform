{
	"info": {
		"name": "Ejada E-Commerce Platform",
		"description": "Demo aid, not a replacement for the automated test suite (see docs/conventions/testing-strategy.md). Hits the gateway on :8080. Populate the {{jwt}} collection variable from the login response and it will be reused by protected requests. Endpoints filled in as each phase implements them — see docs/api/*.md for the full contracts.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" },
		{ "key": "jwt", "value": "" }
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": "{{baseUrl}}/api/v1/auth/register",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"ChangeMe123!\",\n  \"fullName\": \"Demo User\"\n}"
						}
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": "{{baseUrl}}/api/v1/auth/login",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"ChangeMe123!\"\n}"
						}
					}
				}
			]
		},
		{
			"name": "Catalog",
			"item": [
				{
					"name": "List products",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/v1/products"
					}
				}
			]
		},
		{
			"name": "Cart & Checkout",
			"item": [
				{
					"name": "Get my cart",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
						"url": "{{baseUrl}}/api/v1/cart"
					}
				}
			]
		}
	]
}
