    },
    {
      "id": "tMZSNw-v3igEZAiCm4NQ6",
      "type": "text",
      "x": 4862.5229361726415,
      "y": 1291.3989144668237,
      "width": 578.0595703125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bdW",
      "roundness": null,
      "seed": 887301542,
      "version": 2028,
      "versionNonce": 1819698637,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785642146337,
      "link": null,
      "locked": false,
      "text": "Tone to play is encoded into signal. Amplitude is sum of all\nfrequencies at the given time. So both low and high tones.\n\nLow frequency: Peaks and troughs of wave far apart apart\nHigh frequency: Peaks and troughs of wave packed tightly",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "_7yQHEuWVMgx7vL1iZr08",
      "originalText": "Tone to play is encoded into signal. Amplitude is sum of all frequencies at the given time. So both low and high tones.\n\nLow frequency: Peaks and troughs of wave far apart apart\nHigh frequency: Peaks and troughs of wave packed tightly",
      "autoResize": true,
      "lineHeight": 1.25
    },
