      "versionNonce": 627038595,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785642146338,
      "link": null,
      "locked": false,
      "text": "\nDifferent kernels become specialized in finding\ndifferent features. E.g. lines, circles, etc\n\nA layer at a low level of abstraction, with 64\nkernels, can find 64 different types of simple\nedges and colors",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "f2bWNq2-LSug6UaDEg7Ha",
      "originalText": "\nDifferent kernels become specialized in finding different features. E.g. lines, circles, etc\n\nA layer at a low level of abstraction, with 64 kernels, can find 64 different types of simple edges and colors",
      "autoResize": true,
      "lineHeight": 1.25
    },
