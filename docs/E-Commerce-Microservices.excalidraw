    {
      "id": "MYmlXfyDiSoilxL_JNjpu",
      "type": "text",
      "x": 9084.327913833422,
      "y": 3404.8434663735616,
      "width": 133.3596314796887,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
