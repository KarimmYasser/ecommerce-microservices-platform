    {
      "id": "RzniiJ5oi4pBOGq4oyn4v",
      "type": "text",
      "x": -4761.569535560478,
      "y": 1179.4459325279424,
      "width": 526.537642045455,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c012",
      "roundness": null,
      "seed": 1209524218,
      "version": 2189,
      "versionNonce": 301322371,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785642146338,
      "link": null,
      "locked": false,
      "text": "ReLU is an example of an activation function.\n\nReLU allows only positive values to pass through\n[ 12, -5, 0, 8, -2 ] becomes [ 12, 0, 0, 8, 0 ]\n\nWhy? For now just know that they introduce non-\nlinearity, which lets the network go beyond simple\nlinear patterns and learn complex functions.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ReLU is an example of an activation function.\n\nReLU allows only positive values to pass through\n[ 12, -5, 0, 8, -2 ] becomes [ 12, 0, 0, 8, 0 ]\n\nWhy? For now just know that they introduce non-linearity, which lets the network go beyond simple linear patterns and learn complex functions.",
      "autoResize": false,
      "lineHeight": 1.25
    },
