      "updated": 1785642146337,
      "link": null,
      "locked": false,
      "text": "Let's take a look at the big picture\n- The above was a horizontal edge transformation \nIf doing this for a full image, displaying the output matrix would look like this",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Let's take a look at the big picture\n- The above was a horizontal edge transformation \nIf doing this for a full image, displaying the output matrix would look like this",
      "autoResize": true,
      "lineHeight": 1.25
    },
