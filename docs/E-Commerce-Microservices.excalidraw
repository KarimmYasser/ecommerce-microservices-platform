      "index": "bm6",
      "roundness": null,
      "seed": 1710812966,
      "version": 1288,
      "versionNonce": 1154515043,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785642146337,
      "link": null,
      "locked": false,
      "text": "By breaking down the original image into these simple feature\nmaps, the CNN can now start to learn how these simple pieces\ncombine to form more complex objects. For example, it might\nlearn that the street in the image is made of the lines from\nthe crosswalk, and doors, and building roofs\n\nImage is condensed down to its features.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "QnFg-LBPdR7Lk4jYnpGAC",
      "originalText": "By breaking down the original image into these simple feature maps, the CNN can now start to learn how these simple pieces combine to form more complex objects. For example, it might learn that the street in the image is made of the lines from the crosswalk, and doors, and building roofs\n\nImage is condensed down to its features.",
      "autoResize": true,
      "lineHeight": 1.25
    },
