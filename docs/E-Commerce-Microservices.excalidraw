      "updated": 1785642146337,
      "link": null,
      "locked": false,
      "text": "ReLU allows only positive values to pass through\n[ 12, -5, 0, 8, -2 ] becomes [ 12, 0, 0, 8, 0 ]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
