    {
      "id": "S6_XdZZmUrrk4MR0OEDLm",
      "type": "text",
      "x": 4529.663088782598,
      "y": 2819.424584376563,
      "width": 308.9197692871094,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "be5",
      "roundness": null,
      "seed": 1753502522,
      "version": 1646,
      "versionNonce": 1472350989,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785642146337,
      "link": null,
      "locked": false,
      "text": "Same sound, but shifted in time",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same sound, but shifted in time",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4TuTRFgTS8ayWW4gwXhCj",
      "type": "text",
      "x": 4245.686871190923,
      "y": 3133.331929121271,
      "width": 833.3076259093637,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "be6",
      "roundness": null,
      "seed": 1616289062,
      "version": 1640,
      "versionNonce": 883259459,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785642146337,
      "link": null,
      "locked": false,
      "text": "How it's seen by CNN when represented as:\n\nWaveform: Shifting the signal in time completely changes the raw input values. A CNN\nwould have to relearn the same feature at multiple positions, which makes\ngeneralization harder.\n\nMel Spectrogram: Time shift moves the pattern horizontally, but the overall\nfrequency pattern stays intact. CNNs can detect this shape at different time\npositions making them more time-invariant.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How it's seen by CNN when represented as:\n\nWaveform: Shifting the signal in time completely changes the raw input values. A CNN would have to relearn the same feature at multiple positions, which makes generalization harder.\n\nMel Spectrogram: Time shift moves the pattern horizontally, but the overall frequency pattern stays intact. CNNs can detect this shape at different time positions making them more time-invariant.",
      "autoResize": false,
      "lineHeight": 1.25
    },
