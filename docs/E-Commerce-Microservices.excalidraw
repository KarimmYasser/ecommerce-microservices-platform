      "isDeleted": true,
      "boundElements": [],
      "updated": 1785642146337,
      "link": null,
      "locked": false,
      "text": "Regular spectrogram\n- Uses Fourier transform to extract frequencies and their strengths.\nNow we can see: time, frequency and frequency strength, and not just a sum of all frequencies",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Regular spectrogram\n- Uses Fourier transform to extract frequencies and their strengths.\nNow we can see: time, frequency and frequency strength, and not just a sum of all frequencies",
      "autoResize": true,
      "lineHeight": 1.25
    },
