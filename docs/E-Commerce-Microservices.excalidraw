      "seed": 1069035494,
      "version": 454,
      "versionNonce": 1158357325,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785642146336,
      "link": null,
      "locked": false,
      "text": "How to determine allowed strides: ensure the kernel\ncan slide across the input without leaving uneven\ngaps. The output size must be a whole number.\nCalculate (input size - kernel size + 2 * padding) /\nstride + 1, and the result should be an integer",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "LAEVWQeBvVpTvsT_qKLNf",
      "originalText": "How to determine allowed strides: ensure the kernel can slide across the input without leaving uneven gaps. The output size must be a whole number. Calculate (input size - kernel size + 2 * padding) / stride + 1, and the result should be an integer",
      "autoResize": true,
      "lineHeight": 1.25
    },
