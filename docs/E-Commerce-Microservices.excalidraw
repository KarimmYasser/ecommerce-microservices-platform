    {
      "id": "ozmVUjK68fHcp9K_sHwEz",
      "type": "text",
      "x": -2582.5350096974503,
      "y": 13980.568197647663,
      "width": 790.91943359375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bzW",
      "roundness": null,
      "seed": 449540582,
      "version": 804,
      "versionNonce": 1530665069,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785642146338,
      "link": null,
      "locked": false,
      "text": "If layer 2 is used to a specific output from layer 1. During back propagation\nlayer 1 is updated, so it's even better - but its output is not the same anymore,\nso layer 2 performs worse because it was used to the old output from layer 1.\nThe network then has to be trained for longer, to layer 2 can get used to the\nnew output, and utilize it correctly.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If layer 2 is used to a specific output from layer 1. During back propagation layer 1 is updated, so it's even better - but its output is not the same anymore, so layer 2 performs worse because it was used to the old output from layer 1. The network then has to be trained for longer, to layer 2 can get used to the new output, and utilize it correctly.",
      "autoResize": false,
      "lineHeight": 1.25
    },
