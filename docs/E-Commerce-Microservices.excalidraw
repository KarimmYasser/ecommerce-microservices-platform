    {
      "id": "jhjcvxNHO5czr8a_CCYuy",
      "type": "text",
      "x": 4238.171652452917,
      "y": 2544.6492480433617,
      "width": 854.961896157529,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bdj",
      "roundness": null,
      "seed": 2121780794,
      "version": 2391,
      "versionNonce": 547624867,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785642146337,
      "link": null,
      "locked": false,
      "text": "- A point on the waveform is the sum of all frequencies at that moment.\nThe Mel spectrogram instead details each frequency (more more detailed).\nTurns a 1D line into a 2D picture, the CNN can look at\n\n- Mel scale: low frequencies are more important than high frequencies (Mel scale\nemphasizes low frequencies by giving them more resolution, while grouping high\nfrequencies together)\n\n- CNNs are better at handling sounds shifted in time with spectrograms than with\nwaveforms.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- A point on the waveform is the sum of all frequencies at that moment.\nThe Mel spectrogram instead details each frequency (more more detailed).\nTurns a 1D line into a 2D picture, the CNN can look at\n\n- Mel scale: low frequencies are more important than high frequencies (Mel scale emphasizes low frequencies by giving them more resolution, while grouping high frequencies together)\n\n- CNNs are better at handling sounds shifted in time with spectrograms than with waveforms.",
      "autoResize": false,
      "lineHeight": 1.25
    },
