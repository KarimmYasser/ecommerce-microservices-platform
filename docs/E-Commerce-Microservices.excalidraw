    {
      "id": "ZtjhU32W6kK8sTXACBiCw",
      "type": "text",
      "x": -2581.562140449735,
      "y": 14406.37783589811,
      "width": 790.91943359375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bzm",
      "roundness": null,
      "seed": 643432186,
      "version": 1330,
      "versionNonce": 1324259267,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785642146338,
      "link": null,
      "locked": false,
      "text": "Layer 1 and layer 2 are now decoupled. Batch norm is a layer in itself that\nthrough back propagation learns what a good stable output from layer 1 should\nbe. Layer 1 can be adjusted up and down without layer 2 seeing it from the\noutputs. Training is therefore faster, since layer 2 won't have to \"shoot for a\nmoving target\" all the time.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Layer 1 and layer 2 are now decoupled. Batch norm is a layer in itself that through back propagation learns what a good stable output from layer 1 should be. Layer 1 can be adjusted up and down without layer 2 seeing it from the outputs. Training is therefore faster, since layer 2 won't have to \"shoot for a moving target\" all the time.",
      "autoResize": false,
      "lineHeight": 1.25
    },
