    {
      "id": "ZaVo6RJBN93AIVtNp-20y",
      "type": "text",
      "x": -2625.584680833186,
      "y": 6937.828448213641,
      "width": 703.7595825195312,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
