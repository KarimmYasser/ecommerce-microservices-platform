      "seed": 871850682,
      "version": 714,
      "versionNonce": 48168451,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785642146338,
      "link": null,
      "locked": false,
      "text": "Why not just compress the image through a series of linear layers then?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why not just compress the image through a series of linear layers then?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "odMWgeImmxMW33au9AiFo",
      "type": "rectangle",
      "x": -2373.9698179633097,
      "y": 7610.77071921675,
      "width": 685.2940259011785,
      "height": 217.65789319327183,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bqV",
      "roundness": {
        "type": 3
      },
      "seed": 1016364090,
      "version": 1032,
      "versionNonce": 1561991085,
      "isDeleted": true,
      "boundElements": [
        {
          "type": "text",
          "id": "wiqO1Xl9AXVpSB3idxa5K"
        }
      ],
      "updated": 1785642146338,
      "link": null,
      "locked": false
    },
    {
      "id": "wiqO1Xl9AXVpSB3idxa5K",
      "type": "text",
      "x": -2361.898580159205,
      "y": 7629.599665813386,
      "width": 661.1515502929688,
      "height": 180,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bqW",
      "roundness": null,
      "seed": 602727674,
      "version": 2260,
      "versionNonce": 720782755,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785642146338,
      "link": null,
      "locked": false,
      "text": "A linear layer destroys the spatial structure of the image. A convolutional layer is\ndesigned specifically to preserve it.\n\nWhen flattening, all the pixels are put into a list. Their relation isn't stored in the\nnetwork, i.e. that pixel a was next to pixel b. Therefore, no \"local features\" are\npreserved.\n\nWith CNNs, because the kernels scan across patches of the image and sums them up,\nsmall local features can be learned.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "odMWgeImmxMW33au9AiFo",
      "originalText": "A linear layer destroys the spatial structure of the image. A convolutional layer is designed specifically to preserve it.\n\nWhen flattening, all the pixels are put into a list. Their relation isn't stored in the network, i.e. that pixel a was next to pixel b. Therefore, no \"local features\" are preserved.\n\nWith CNNs, because the kernels scan across patches of the image and sums them up, small local features can be learned.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "X08QJRAHX1EKWIRIuWLC_",
      "type": "line",
      "x": -2170.5257975066775,
      "y": 7810.302807322627,
      "width": 279.6615185427934,
      "height": 1.3355614059082654,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bqX",
      "roundness": {
        "type": 2
      },
      "seed": 953380282,
      "version": 200,
      "versionNonce": 1521785357,
