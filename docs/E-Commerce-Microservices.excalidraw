      "updated": 1785642146339,
      "link": null,
      "locked": false,
      "text": "Captures small localized features with\n3x3 kernels.\n\nEach conv layer halves the dimension\nsize, while doubling the amount of\nchannels.\n\nDownsamples 2x per residual block",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Captures small localized features with 3x3 kernels.\n\nEach conv layer halves the dimension size, while doubling the amount of channels.\n\nDownsamples 2x per residual block",
      "autoResize": false,
      "lineHeight": 1.25
    },
