    {
      "id": "caEgzUPbFBjNQGo9UQI8r",
      "type": "text",
      "x": -2629.2650137427154,
      "y": 4633.252925700903,
      "width": 605.299560546875,
      "height": 175,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
