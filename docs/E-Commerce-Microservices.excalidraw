    {
      "id": "zFH1UpO9UaHYxN2pkbAG8",
      "type": "text",
      "x": 501.96096260286106,
      "y": 2227.19035391913,
      "width": 821.2223017064538,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bQF",
      "roundness": null,
      "seed": 976056122,
      "version": 381,
      "versionNonce": 1641967011,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785642146336,
      "link": null,
      "locked": false,
      "text": "- Stride is how many pixels the kernel skips sliding over the input in a CNN. It\naffects how much you learn and how fast it runs.\n- Stride balances detail capture and computational efficiency\n\n- Small stride (like 1) moves one pixel, grabs more details, and makes a bigger\noutput, but takes more work. \n- Larger stride (like 2 or 3) jumps more, loses details, shrinks output, and works\nfaster.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Stride is how many pixels the kernel skips sliding over the input in a CNN. It affects how much you learn and how fast it runs.\n- Stride balances detail capture and computational efficiency\n\n- Small stride (like 1) moves one pixel, grabs more details, and makes a bigger output, but takes more work. \n- Larger stride (like 2 or 3) jumps more, loses details, shrinks output, and works faster.",
      "autoResize": false,
      "lineHeight": 1.25
    },
