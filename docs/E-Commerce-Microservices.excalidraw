    {
      "id": "BM9-AIPEHMxfLNBliFNyV",
      "type": "rectangle",
      "x": -2528.926425080475,
      "y": 9775.635918836846,
      "width": 562.1690579859821,
      "height": 105.40303806978048,
      "angle": 0,
      "strokeColor": "#2f9e44",
