    {
      "id": "L71BOlc2J5D5e-LUllR4S",
      "type": "text",
      "x": 3015.4526540804873,
      "y": 2881.4202681786173,
      "width": 502.4996337890625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1971c2",
