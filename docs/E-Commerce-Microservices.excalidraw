    },
    {
      "id": "3mHmh5jURfT4sCZKMsGqg",
      "type": "text",
      "x": 1948.9863191713036,
      "y": 1835.2506305814989,
      "width": 381.2477111816406,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGD",
      "roundness": null,
      "seed": 1522669542,
      "version": 913,
      "versionNonce": 1076619459,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785642146335,
      "link": null,
      "locked": false,
      "text": "A kernel size of 1 doesn't capture spatial\nfeatures well since it only looks at one pixel at\na time. To spot features, multiple pixels need to\nbe analyzed together, reducing the information\nto fewer dimensions, which larger kernels like 3x3\ndo better",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b9WZsWkpRLrwXZMzsec0K",
      "originalText": "A kernel size of 1 doesn't capture spatial features well since it only looks at one pixel at a time. To spot features, multiple pixels need to be analyzed together, reducing the information to fewer dimensions, which larger kernels like 3x3 do better",
      "autoResize": true,
      "lineHeight": 1.25
    },
